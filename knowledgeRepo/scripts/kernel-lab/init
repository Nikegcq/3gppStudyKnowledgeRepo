#!/bin/busybox sh
# Minimal initramfs init for the QEMU/GDB debug kernel.
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev 2>/dev/null

echo INITRAMFS_OK
echo -n "kernel: "
uname -r
echo -n "cmdline: "
cat /proc/cmdline

case "$(cat /proc/cmdline)" in
*debugshell*)
	echo "DEBUGSHELL: dropping to /bin/sh"
	exec /bin/sh
	;;
esac

echo USERSPACE_READY

sleep 5
poweroff -f
