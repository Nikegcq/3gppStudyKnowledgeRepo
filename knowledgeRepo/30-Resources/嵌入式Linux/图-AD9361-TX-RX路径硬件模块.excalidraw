      "versionNonce": 286140161,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false
    },
    {
      "id": "el0162",
      "type": "text",
      "x": 872.0,
      "y": 151.7,
      "width": 88.75,
      "height": 20.25,
      "angle": 0,
      "strokeColor": "#1864ab",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
