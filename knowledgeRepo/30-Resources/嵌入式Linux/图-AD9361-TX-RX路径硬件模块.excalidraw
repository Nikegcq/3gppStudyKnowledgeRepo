    },
    {
      "id": "el0160",
      "type": "text",
      "x": 872.0,
      "y": 68.0,
      "width": 496.0,
      "height": 32.400000000000006,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 383975071,
      "version": 1,
      "versionNonce": 494485441,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "对照左侧数据流阅读。BBBW = 基带带宽 ≈ 复信号带宽的一半。\n滤波器角点常用：Rx BB 1.4×BBBW，Rx TIA 2.5×BBBW，Tx BB 1.6×BBBW，Tx 二级 5×BBBW。",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "对照左侧数据流阅读。BBBW = 基带带宽 ≈ 复信号带宽的一半。\n滤波器角点常用：Rx BB 1.4×BBBW，Rx TIA 2.5×BBBW，Tx BB 1.6×BBBW，Tx 二级 5×BBBW。",
      "lineHeight": 1.35,
      "baseline": 12
    },
    {
      "id": "el0161",
      "type": "rectangle",
      "x": 860.0,
      "y": 141.7,
      "width": 520.0,
      "height": 297.04999999999995,
      "angle": 0,
      "strokeColor": "#1864ab",
      "backgroundColor": "#d0ebff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 533502200,
