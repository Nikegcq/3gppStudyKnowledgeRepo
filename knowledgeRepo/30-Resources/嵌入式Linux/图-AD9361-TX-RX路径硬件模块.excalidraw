    {
      "id": "el0165",
      "type": "text",
      "x": 872.0,
      "y": 472.74999999999994,
      "width": 103.75,
      "height": 20.25,
      "angle": 0,
      "strokeColor": "#5f3dc4",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
