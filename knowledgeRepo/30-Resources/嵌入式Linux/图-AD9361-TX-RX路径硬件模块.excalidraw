			"roundness": null,
			"seed": 383975071,
			"version": 2,
			"versionNonce": 1263220742,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1789655940823,
			"link": null,
			"locked": false,
			"text": "对照左侧数据流阅读。BBBW = 基带带宽 ≈ 复信号带宽的一半。\n滤波器角点常用：Rx BB 1.4×BBBW，Rx TIA 2.5×BBBW，Tx BB 1.6×BBBW，Tx 二级 5×BBBW。",
			"fontSize": 12,
			"fontFamily": 2,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "对照左侧数据流阅读。BBBW = 基带带宽 ≈ 复信号带宽的一半。\n滤波器角点常用：Rx BB 1.4×BBBW，Rx TIA 2.5×BBBW，Tx BB 1.6×BBBW，Tx 二级 5×BBBW。",
			"lineHeight": 1.35,
			"baseline": 12,
			"autoResize": true,
			"index": "b1Z",
