			"text": "TX 路径术语",
			"fontSize": 15,
			"fontFamily": 2,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "TX 路径术语",
			"lineHeight": 1.35,
			"baseline": 15,
			"autoResize": true,
			"index": "b1h",
			"hasTextLink": false,
			"rawText": "",
