      "versionNonce": 184230,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "• T_TA = (N_TA + …) × T_c，见 38.213 §4.2",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• T_TA = (N_TA + …) × T_c，见 38.213 §4.2",
      "lineHeight": 1.25,
      "baseline": 13
    },
