      "link": null,
      "locked": false,
      "text": "为何要记 T_c？",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "为何要记 T_c？",
      "lineHeight": 1.25,
      "baseline": 16
    },
    {
      "id": "el2122",
      "type": "text",
      "x": 440.0,
      "y": 308.0,
      "width": 308.2,
      "height": 16.25,
      "angle": 0,
      "strokeColor": "#e8590c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 125813,
      "version": 1,
      "versionNonce": 8106,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "• 规范里所有时长写成 N × T_c，不是直接写微秒",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• 规范里所有时长写成 N × T_c，不是直接写微秒",
      "lineHeight": 1.25,
      "baseline": 13
    },
    {
      "id": "el2123",
      "type": "text",
      "x": 440.0,
      "y": 332.0,
      "width": 283.5,
      "height": 16.25,
      "angle": 0,
      "strokeColor": "#e8590c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 521547,
      "version": 1,
      "versionNonce": 783302,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "• 帧号相同 ≠ 物理时间对齐：UL 有 TA 提前",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• 帧号相同 ≠ 物理时间对齐：UL 有 TA 提前",
      "lineHeight": 1.25,
      "baseline": 13
    },
    {
